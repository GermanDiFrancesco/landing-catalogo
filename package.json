{
  "name": "tecnografic",
  "version": "1.0.0",
  "description": "Sitio web oficial estático de Tecnografic S.A. (SPA Vanilla JS con Hash Router)",
  "scripts": {
    "tw:build": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/output.css --minify",
    "tw:watch": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/output.css --watch",
    "build": "npm run tw:build"
  },
  "keywords": [
    "tecnografic",
    "static",
    "vanilla-js",
    "spa",
    "hash-router"
  ],
  "author": "Tecnografic S.A.",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19"
  }
}
