{
  "name": "tecnografic",
  "version": "1.0.0",
  "description": "Sitio web oficial estático de Tecnografic S.A. (SPA Vanilla JS con Hash Router)",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "smtp:verify": "node server.js --verify-smtp",
    "smtp:test": "node server.js --send-test",
    "tw:build": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/output.css --minify",
    "tw:watch": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/output.css --watch",
    "build": "npm run tw:build",
    "cache:clear": "node scripts/clear-cache.mjs"
  },
  "keywords": [
    "tecnografic",
    "static",
    "vanilla-js",
    "spa",
    "hash-router"
  ],
  "author": "Tecnografic S.A.",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "nodemailer": "^10.6.1"
  }
}
